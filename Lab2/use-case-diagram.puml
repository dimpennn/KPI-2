@startuml
skinparam monochrome true
skinparam shadowing false
left to right direction

package "DimPenShelf" {

  actor "Reader" as Reader
  actor "Author" as Author
  actor "Librarian" as Librarian

  ''' Author успадковує всі права Читача '''
  Author -|> Reader

  usecase "Перегляд каталогу книг" as UC1
  usecase "Бронювання книги" as UC2
  usecase "Оплата оренди книги" as UC3
  usecase "Оформлення доставки" as UC4
  usecase "Отримання примірника" as UC5
  usecase "Залишити відгук / оцінку" as UC6
  usecase "Додавання книги та статистика читань" as UC7

  ''' Читач '''
  Reader --> UC1
  Reader --> UC2
  Reader --> UC3
  Reader --> UC4
  Reader --> UC5
  Reader --> UC6

  ''' Автор '''
  Author --> UC7

  ''' Бібліотекар видає примірник '''
  Librarian --> UC5
}

@enduml