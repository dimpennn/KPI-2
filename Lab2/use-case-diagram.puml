@startuml
skinparam monochrome true
skinparam shadowing false
left to right direction

package "DimPenShelf" {

  actor "Читач" as Reader
  actor "Автор" as Author
  actor "Служба доставки" as Delivery
  actor "Платіжна система" as Payment

  ''' Author успадковує всі права та можливості Читача '''
  Author -|> Reader

  usecase "Перегляд каталогу книг" as UC1
  usecase "Бронювання книги" as UC2
  usecase "Оплата оренди книги" as UC3
  usecase "Оформлення доставки" as UC4
  usecase "Отримання примірника" as UC5
  usecase "Залишити відгук / оцінку" as UC6
  usecase "Додавання книги" as UC7
  usecase "Перегляд статистики читань" as UC8

  usecase "Авторизація оплати" as ExtPayAuth <<extend>>
  usecase "Повернення коштів" as ExtPayRefund <<extend>>
  usecase "Обчислення ціни та терміну доставки" as ExtDelCalc <<extend>>
  usecase "Генерація накладної" as ExtDelInvoice <<extend>>

  ''' Базові прецеденти Читача '''
  Reader --> UC1
  Reader --> UC2
  Reader --> UC3
  Reader --> UC4
  Reader --> UC5
  Reader --> UC6

  ''' Прецеденти Autorа '''
  Author --> UC7
  Author --> UC8

  ''' Взовнішні системи '''
  Payment --> UC3
  Delivery --> UC4

  ''' Include — обов'язкові підпроцеси '''
  UC3 ..> ExtPayAuth : include
  UC4 ..> ExtDelCalc : include
  UC4 ..> ExtDelInvoice : include

  ''' Extend — додаткова / умовна поведінка '''
  UC3 ..> ExtPayRefund : extend
  UC2 ..> UC4 : extend
}

@enduml
