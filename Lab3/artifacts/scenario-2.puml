@startuml
title Scenario 2 — Cash or card payment at the physical cashier (UC-05)
skinparam sequenceMessageAlign center

participant "User" as User
participant "Cashier" as Cashier
participant "Frontend" as Frontend
participant "Backend" as Backend
participant "Database" as Database
participant "Payment Terminal" as Terminal

autonumber

' 1) User approaches the cashier and names the reservation id
User -> Cashier: provide reservation ID at the counter
activate Cashier

' 2) Cashier enters the id in the frontend search
Cashier -> Frontend: type reservation ID into POS search field
activate Frontend

' 3) Frontend asks the backend for the reservation data
Frontend -> Backend: GET /api/v1/reservations/{reservation_id}

' 4) Backend queries the database, incl. the reserved physical book copy
Backend -> Database: SELECT r.status, r.expires_at, c.copy_id, c.status, b.title\\nFROM reservations r\\nJOIN book_copies c ON c.copy_id = r.copy_id\\nJOIN books b ON b.book_id = c.book_id\\nWHERE r.reservation_id = ?
activate Backend
activate Database
Database --> Backend: {status: PENDING, copyId, title, copyStatus: RESERVED}

' 6) Backend returns the data; the cashier sees order details on the monitor
Backend --> Frontend: 200 OK {reservation, bookCopy, user}
Frontend -> Cashier: show order details on the monitor

' 7) Cashier asks the user for the preferred payment method
Cashier -> User: ask preferred payment method: cash or card

alt Cash
  ' 9) Cashier selects Cash on the interface and accepts money
  Cashier -> Frontend: select Cash on the POS interface, accept cash from user
  ' 10) Frontend calculates the change
  Frontend -> User: calculate and display change due
  ' 11) Cashier hands the change to the user
  Cashier -> User: hand over change
else Card
  ' 9) Cashier selects Pay by card; frontend sends the amount to the terminal
  Cashier -> Frontend: select Pay by card on the POS interface
  Frontend -> Terminal: POST /api/v1/terminal/charge\\n{amount}
  activate Terminal
  ' 10) User taps the card on the terminal
  User -> Terminal: tap or insert card, enter PIN
  ' 11) Terminal debits funds and returns the payment status
  Terminal --> Frontend: payment status: APPROVED
  deactivate Terminal
end

' 12) Frontend sends the payment status to the backend
Frontend -> Backend: POST /api/v1/payments\\n{reservation_id, method: CASH|CARD, amount, status: PAID}
activate Backend

' 13) Backend sets the copy to IN_USE, writes the issue date and computes the return date
Backend -> Database: UPDATE book_copies SET status = 'IN_USE',\\nborrowed_at = NOW(), due_date = NOW() + INTERVAL '14 days'\\nWHERE copy_id = ?
activate Database
Database --> Backend: {copyUpdated: 1, dueDate}
deactivate Database

' 14) Backend confirms the updated data
Backend --> Frontend: 200 OK {copyId, status: IN_USE, dueDate}
deactivate Backend

' 15) Cashier hands the book copy to the user
Frontend -> Cashier: print receipt with due date
Cashier -> User: hand over the book copy and receipt

deactivate Cashier
deactivate Frontend

@enduml