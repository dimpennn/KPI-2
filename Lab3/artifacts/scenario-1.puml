@startuml
title Scenario 1 — Online reservation payment (UC-03)
skinparam sequenceMessageAlign center
hide footbox

actor "User" as User
participant "Frontend" as Frontend
participant "Backend" as Backend
participant "Database" as Database
participant "Payment Gateway" as Gateway

autonumber

activate User
activate Frontend

User -> Frontend: choose reserved book, select delivery branch,\nclick "Proceed to payment"
Frontend -> Backend: POST /api/v1/reservations/{reservation_id}/payment\n{deliveryService, branchOffice, paymentMethod: ONLINE_GATEWAY}

Backend -> Database: fetchReservation {reservation_id}
activate Database
Database --> Backend: {status: PENDING, expiresAt, rentalPrice}
deactivate Database

alt Reservation.status == PENDING and now < expires_at
  Backend -> Database: createDelivery {service, branchOffice, cost}
  activate Database
  Database --> Backend: {deliveryId}
  deactivate Database

  Backend -> Gateway: POST /api/v1/payments/sessions\n{amount, reservation_id, returnUrl}
  activate Gateway
  Gateway --> Backend: {paymentUrl, external_transaction_id}
  deactivate Gateway

  Backend --> Frontend: 200 OK {paymentUrl, orderNumber: reservation_id}
  deactivate Backend

  Frontend -> User: HTTP 302 redirect to paymentUrl

  User -> Gateway: enter card details and confirm payment
  activate Backend
  Gateway -> Backend: webhook POST /api/v1/webhooks/payment\n{external_transaction_id, status}

  alt Payment.status == AUTHORIZED
    Backend -> Database: finalizeReservation\n{Payment ONLINE_GATEWAY/AUTHORIZED,\nReceipt {borrowed_at, due_date}, copy status IN_USE}
    activate Database
    Database --> Backend: {paymentId, receiptId}
    deactivate Database
    Backend --> Gateway: 200 OK
    deactivate Backend
  else Payment.status != AUTHORIZED
    Backend -> Database: markPaymentFailed {paymentId}
    activate Database
    Database --> Backend: {rowsUpdated}
    deactivate Database
    Backend --> Gateway: 200 OK
    deactivate Backend
  end

  Gateway -> User: HTTP 302 redirect to /orders/{reservation_id}/result

  Frontend -> Backend: GET /api/v1/reservations/{reservation_id}
  activate Backend
  Backend -> Database: fetchReservation {reservation_id}
  activate Database
  Database --> Backend: {status: FULFILLED, orderNumber, branchOffice}
  deactivate Database
  Backend --> Frontend: 200 OK {status: FULFILLED, orderNumber, branchOffice}
  deactivate Backend

  Frontend -> User: display "Payment successful — order #{reservation_id}, branch office"
else
  Backend -> Database: expireReservation {Reservation EXPIRED, copy status AVAILABLE}
  activate Database
  Database --> Backend: {reservationExpired}
  deactivate Database
  Backend --> Frontend: 410 Gone {error: Reservation expired}
  deactivate Backend
  Frontend -> User: display "Payment failed — reservation has expired"
end

deactivate Frontend
deactivate User
@enduml